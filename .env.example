# SEC EDGAR User-Agent (Required by SEC fair-access policy: Name and Contact Email)
SEC_USER_AGENT="Your Name your.email@example.com"

# Google Gemini API Key (Optional; read ONLY by GeminiProvider when llm_provider=gemini)
GEMINI_API_KEY="your-gemini-api-key-placeholder"

# OpenFIGI API Key (Optional; passed to sec_13f_analyzer for higher rate limits)
OPENFIGI_API_KEY=""

# Kill switch: set to 1 to disable all LLM calls and enforce offline behavior
AUTOPILOT_LLM_DISABLED="0"

# Optional path to YAML configuration file
AUTOPILOT_CONFIG_PATH="config.yaml"
